# Copy to .env and fill in what you use. Everything except APP_PASSWORD is optional,
# and keys can also be pasted into Settings instead. See docs/configuration.md.

# Required when the app listens beyond localhost, which it does in Docker.
APP_PASSWORD=

# Set to 1 behind a reverse proxy with HTTPS.
# TRUST_PROXY=1

# Timezone for reading reset times and for repeating messages.
# TZ=Europe/London

# --- Claude Code ---------------------------------------------------------
# From `claude setup-token` on a machine where you are signed in.
# CLAUDE_CODE_OAUTH_TOKEN=

# --- API providers -------------------------------------------------------
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# GEMINI_API_KEY=

# --- Ollama --------------------------------------------------------------
# Run Ollama in Docker next to Nightshift:
# COMPOSE_PROFILES=ollama
# OLLAMA_BASE_URL=http://ollama:11434
#
# Or leave these unset to use an Ollama on the host
# (http://host.docker.internal:11434 in Docker, http://127.0.0.1:11434 otherwise).
# OLLAMA_API_KEY=

# --- Notifications -------------------------------------------------------
# An ntfy topic URL, or a Discord or Slack webhook.
# NOTIFY_URL=
